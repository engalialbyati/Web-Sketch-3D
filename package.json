{
  "name": "websketch3d",
  "private": true,
  "version": "0.8.0",
  "description": "WebSketch 3D — a SketchUp/AutoCAD-style 3D drawing & BIM app with MNL-66 reinforcement detailing.",
  "scripts": {
    "test": "node test/run.js",
    "serve": "node server/staticServer.js",
    "bridge": "node server/blenderkitBridge.js",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "manifold-3d": "^3.5.4",
    "three-mesh-bvh": "^0.5.6"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.websketch3d.app",
    "productName": "WebSketch 3D",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "js/**",
      "css/**",
      "index.html",
      "families/**",
      "assets/**",
      "README.md",
      "docs/AI-AUTHORING.md",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WebSketch3D-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebSketch 3D"
    }
  }
}
